# Deploy 20251229_222324

# CodeGraph semantic index (local, ~94MB SQLite, rebuilt with `codegraph init`)
.codegraph/

# RTK generated artifacts (token-savings analytics + local instructions)
RTK.md
.rtk/

# Docker delivery package (generated by npm run deploy:docker -- <client>)
# One subfolder per client under deploy/ (e.g. deploy/amreport/) — never
# commit the built image archive (1GB+) or any real .env, for any client.
deploy/*/echatbot-images.tar.gz
deploy/*/.env.example
deploy/*/.env
# Legacy flat layout (pre client-subfolder split) — kept in case old checkouts
# or scripts still reference it directly.
deploy/echatbot-images.tar.gz
deploy/.env.example
deploy/.env

